class Solution {
    public boolean pairInSortedRotated(int[] arr, int target) {

        int n = arr.length;

        // Find the pivot (smallest element)
        int i;
        for (i = 0; i < n - 1; i++) {
            if (arr[i] > arr[i + 1]) {
                break;
            }
        }

        // i = index of largest element
        int right = i;
        int left = (i + 1) % n;

        while (left != right) {

            int sum = arr[left] + arr[right];

            if (sum == target) {
                return true;
            }

            if (sum < target) {
                left = (left + 1) % n;
            } else {
                right = (right - 1 + n) % n;
            }
        }

        return false;
    }
}
