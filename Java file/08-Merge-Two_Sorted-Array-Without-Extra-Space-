class Solution {

    private int nextGap(int gap) {
        if (gap <= 1)
            return 0;
        return (gap / 2) + (gap % 2);
    }

    public void merge(int arr1[], int arr2[]) {

        int n = arr1.length;
        int m = arr2.length;

        int gap = nextGap(n + m);

        while (gap > 0) {

            int i = 0;
            int j = gap;

            while (j < n + m) {

                // Both pointers in arr1
                if (i < n && j < n) {

                    if (arr1[i] > arr1[j]) {
                        int temp = arr1[i];
                        arr1[i] = arr1[j];
                        arr1[j] = temp;
                    }
                }

                // i in arr1, j in arr2
                else if (i < n && j >= n) {

                    if (arr1[i] > arr2[j - n]) {
                        int temp = arr1[i];
                        arr1[i] = arr2[j - n];
                        arr2[j - n] = temp;
                    }
                }

                // Both pointers in arr2
                else {

                    if (arr2[i - n] > arr2[j - n]) {
                        int temp = arr2[i - n];
                        arr2[i - n] = arr2[j - n];
                        arr2[j - n] = temp;
                    }
                }

                i++;
                j++;
            }

            gap = nextGap(gap);
        }
    }
}
