class Solution {

    int[] findTwoElement(int arr[]) {

        int n = arr.length;
        int[] freq = new int[n + 1];

        int repeating = -1;
        int missing = -1;

        for (int num : arr) {
            freq[num]++;
        }

        for (int i = 1; i <= n; i++) {

            if (freq[i] == 2)
                repeating = i;

            if (freq[i] == 0)
                missing = i;
        }

        return new int[]{repeating, missing};
    }
}
