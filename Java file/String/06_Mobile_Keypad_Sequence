class Solution {
    public String printSequence(String s) {

        String[] keypad = {
            "2", "22", "222",
            "3", "33", "333",
            "4", "44", "444",
            "5", "55", "555",
            "6", "66", "666",
            "7", "77", "777", "7777",
            "8", "88", "888",
            "9", "99", "999", "9999"
        };

        StringBuilder ans = new StringBuilder();

        for (char ch : s.toUpperCase().toCharArray()) {
            if (ch >= 'A' && ch <= 'Z') {
                ans.append(keypad[ch - 'A']);
            }
        }

        return ans.toString();
    }
}
